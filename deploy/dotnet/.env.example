# Copy to deploy/dotnet/.env; Docker Compose loads it automatically for this stack.
# Never commit the filled file.

# HMAC key for sessions, magic links and OIDC state. Generate with: openssl rand -hex 32
COMPLY_AUTH_SECRET=replace-with-openssl-rand-hex-32

# API origin written into the Angular config.js at container start.
COMPLY_API_BASE=http://localhost:7071

# Public port of the Angular container.
WEB_PORT=8080

# Optional external sign-in. Leave empty to keep the providers hidden. Register the callback
# URLs printed in README.md with the API host (http://localhost:7071 locally).
COMPLY_OIDC_GOOGLE_CLIENT_ID=
COMPLY_OIDC_GOOGLE_CLIENT_SECRET=
COMPLY_OIDC_MICROSOFT_CLIENT_ID=
COMPLY_OIDC_MICROSOFT_CLIENT_SECRET=
COMPLY_OIDC_MICROSOFT_TENANT=common
COMPLY_OIDC_GITHUB_CLIENT_ID=
COMPLY_OIDC_GITHUB_CLIENT_SECRET=
