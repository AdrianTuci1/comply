{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://comply.local/contracts/content/framework.schema.json",
  "title": "Framework descriptor",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "frameworkId",
    "version",
    "docType",
    "title",
    "effectiveFrom",
    "source",
    "license"
  ],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9-]+/[0-9]{4}\\.[0-9]+\\.[0-9]+$" },
    "frameworkId": {
      "type": "string",
      "enum": ["nis2", "iso27001", "ai-act", "soc2"]
    },
    "version": { "type": "string", "pattern": "^[0-9]{4}\\.[0-9]+\\.[0-9]+$" },
    "docType": { "const": "framework" },
    "title": { "type": "string", "minLength": 5 },
    "effectiveFrom": { "type": "string", "format": "date" },
    "source": { "type": "string", "minLength": 5 },
    "license": { "type": "string", "enum": ["public", "proprietary"] }
  }
}
